# Copy to .env. `pnpm dev`, `start`, `trail` and `db:migrate` load it if present;
# a variable already set in the shell wins over the file.
DATABASE_PATH=./data/trail.db
PORT=3000
# The server refuses to start without these two. The owner is a GitHub username (any case);
# the secret is 32+ random characters, e.g. `openssl rand -base64 32`.
TRAIL_OWNER_GITHUB=
BETTER_AUTH_SECRET=
# GitHub OAuth app; without both, people cannot sign in (503) and bots work as before.
# Its callback URL is <origin>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The public origin, e.g. https://trail.fly.dev. Required behind a TLS-terminating proxy such as
# Fly's, where requests reach the server as http; unset, the origin comes from each request.
BETTER_AUTH_URL=

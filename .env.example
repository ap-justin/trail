# Copy to .env. `pnpm dev`, `start`, `trail` and `db:migrate` load it if present;
# a variable already set in the shell wins over the file.
DATABASE_PATH=./data/trail.db
PORT=3000
# The server refuses to start without these two. The owner is a GitHub username (any case, no @);
# the first account to sign in under it stays the owner. The secret is 32+ random characters,
# e.g. `openssl rand -base64 32`.
TRAIL_OWNER_GITHUB=
BETTER_AUTH_SECRET=
# People's sign-in needs all three below; until then it answers 503 and bots work as before.
# The GitHub OAuth app's callback URL is <BETTER_AUTH_URL>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The public origin, e.g. https://trail.fly.dev: behind Fly's TLS-terminating proxy, requests reach
# the server as http, so the origin can't come from the request. Leave it unset for `pnpm dev:web`:
# the browser is on the Vite origin (http://localhost:5173), which the server must not pin to :3000.
BETTER_AUTH_URL=

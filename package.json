{
  "name": "trail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "build": "tsup",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/index.js",
    "lint": "biome check",
    "format": "biome check --write",
    "smoke": "pnpm build && sh scripts/smoke.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "tsx src/server/db/generate.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/migrate.ts",
    "trail": "tsx --env-file-if-exists=.env src/server/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
